Project:
  Name: ChainedDecos
  IconPath: resources/icons/chaineddecos.jpg
  StartScene: scenes/rpg_strategy_scene.chscene
  AssetDirectory: assets
  ActiveScene: assets/scenes/start_menu.chscene
  Environment: ""
  BuildScenes:
    - scenes/start_menu.chscene
    - scenes/title_image.chscene
    - scenes/main_menu.chscene
    - scenes/game_mode_selection.chscene
    - scenes/map_selection.chscene
    - scenes/video_scene.chscene
    - scenes/info_scene.chscene
    - scenes/untitled100.chscene
    - scenes/scene_tem.chscene
    - scenes/test_platform_scene.chscene
  Physics:
    Gravity: 17.2999992
    FixedTimestep: 0.00416666688
  Animation:
    TargetFPS: 60
  Render:
    ShadowResolution: 2048
    EnableShadows: true
    AntiAliasingSamples: 4
  Mesh:
    ImportMaterials: true
    CalculateTangents: true
    FlipUVs: true
  Window:
    Width: 1920
    Height: 1080
    VSync: false
    Resizable: true
  Audio:
    MasterVolume: 1
    MusicVolume: 1
    SFXVolume: 1
  Runtime:
    Fullscreen: false
    ShowStats: true
    EnableConsole: false
    TargetFPS: 0
  Editor:
    CameraMoveSpeed: 64.9000015
    CameraRotationSpeed: 0.100000001
    CameraBoostMultiplier: 5
    DisableCameraZoom: false
  Scripting:
    ModuleName: ChainedDecos.Scripts.dll
    ModuleDirectory: assets/bin
    AutoLoad: true
  BuildConfig: 0