Project:
  Name: ChainedDecos
  IconPath: resources/icons/chaineddecos.jpg
  StartScene: scenes\start_menu.chscene
  AssetDirectory: assets
  ActiveScene: assets/scenes/rpg_strategy_scene.chscene
  Environment: ""
  BuildScenes:
    - scenes/start_menu.chscene
    - scenes/title_image.chscene
    - scenes/main_menu.chscene
    - scenes/game_mode_selection.chscene
    - scenes/map_selection.chscene
    - scenes/video_scene.chscene
    - scenes/info_scene.chscene
    - scenes/untitled100.chscene
    - scenes/scene_tem.chscene
    - scenes/test_platform_scene.chscene
  Physics:
    Gravity: 20
    FixedTimestep: 0.00416666688
  Animation:
    TargetFPS: 60
  Render:
    AmbientIntensity: 1
    DefaultExposure: 1.42999995
  Texture:
    GenerateMipmaps: true
    Filter: 5
  Window:
    Width: 1920
    Height: 1080
    VSync: false
    Resizable: true
  Editor:
    CameraMoveSpeed: 64.9000015
  Scripting:
    ModuleName: ChainedDecos.Scripts.dll
    ModuleDirectory: scripts/bin
    AutoLoad: true
  LaunchProfiles:
    - Name: Debug Runtime
      BinaryPath: ${BUILD}/ChainedRuntime.exe
      Arguments: --project "${PROJECT_FILE}"
  BuildConfig: 0