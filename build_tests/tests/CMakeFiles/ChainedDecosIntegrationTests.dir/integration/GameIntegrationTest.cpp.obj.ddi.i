template <typename T, typename U>
inline Matcher<T> SafeMatcherCast(const Matcher<U>& matcher) {

  static_assert(std::is_convertible<const T&, const U&>::value,
                "T must be implicitly convertible to U");


  static_assert(std::is_reference<T>::value || !std::is_reference<U>::value,
                "cannot convert non reference arg to reference");


  typedef typename std::remove_const<typename std::remove_reference<T>::type>::type RawT;
  typedef typename std::remove_const<typename std::remove_reference<U>::type>::type RawU;
  constexpr bool kTIsOther = static_cast< ::testing::internal::TypeKind>( ::testing::internal::KindOf<RawT>::value) == internal::kOther;
  constexpr bool kUIsOther = static_cast< ::testing::internal::TypeKind>( ::testing::internal::KindOf<RawU>::value) == internal::kOther;
  static_assert(
      kTIsOther || kUIsOther ||
          (internal::LosslessArithmeticConvertible<RawT, RawU>::value),
      "conversion of arithmetic types must be lossless");
  return MatcherCast<T>(matcher);
}


