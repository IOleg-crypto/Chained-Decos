# SDL3 dependency
if(EXISTS "${CMAKE_SOURCE_DIR}/thirdparty/SDL/CMakeLists.txt")
    set(SDL_SHARED OFF CACHE BOOL "" FORCE)
    set(SDL_STATIC ON CACHE BOOL "" FORCE)
    set(SDL_TEST OFF CACHE BOOL "" FORCE)
    set(SDL_TESTS OFF CACHE BOOL "" FORCE)
    set(SDL_VULKAN OFF CACHE BOOL "" FORCE)
    set(SDL_OPENGLES OFF CACHE BOOL "" FORCE)
    set(SDL_RENDER OFF CACHE BOOL "" FORCE)
    add_subdirectory("${CMAKE_SOURCE_DIR}/thirdparty/SDL" "${CMAKE_BINARY_DIR}/vendor/sdl3" EXCLUDE_FROM_ALL)
else()
    message(WARNING "SDL3 submodule not found at ${CMAKE_SOURCE_DIR}/thirdparty/SDL - SDL3 backend will not be available")
endif()
